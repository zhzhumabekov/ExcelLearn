{
  "$defs": {
    "AddSelect": {
      "additionalProperties": false,
      "description": "С нажатым Ctrl протянуть ещё один диапазон — выделение из нескольких частей.",
      "properties": {
        "addSelect": {
          "pattern": "^[A-Z]{1,3}[1-9][0-9]*(:[A-Z]{1,3}[1-9][0-9]*)?$",
          "type": "string"
        }
      },
      "required": [
        "addSelect"
      ],
      "title": "AddSelect",
      "type": "object"
    },
    "Autocomplete": {
      "additionalProperties": false,
      "description": "Двойной щелчок по имени (функции или диапазона) в списке автозавершения формулы.",
      "properties": {
        "autocomplete": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "autocomplete"
      ],
      "title": "Autocomplete",
      "type": "object"
    },
    "CellSpec": {
      "additionalProperties": false,
      "properties": {
        "v": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "f": {
          "anyOf": [
            {
              "pattern": "^=",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Формула, уже записанная в ячейке шаблона"
        },
        "fmt": {
          "default": "general",
          "description": "date, dateLong: v — дата «2025-05-01» (в листе — серийный номер Excel); dateLong — длинный формат «4 января 2003 г.»",
          "enum": [
            "general",
            "number",
            "usd",
            "kzt",
            "percent",
            "date",
            "dateLong"
          ],
          "type": "string"
        },
        "style": {
          "anyOf": [
            {
              "enum": [
                "head",
                "label",
                "total"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "CellSpec",
      "type": "object"
    },
    "Click": {
      "additionalProperties": false,
      "properties": {
        "click": {
          "pattern": "^[A-Z]{1,3}[1-9][0-9]*$",
          "type": "string"
        }
      },
      "required": [
        "click"
      ],
      "title": "Click",
      "type": "object"
    },
    "ClickRef": {
      "additionalProperties": false,
      "properties": {
        "clickRef": {
          "pattern": "^[A-Z]{1,3}[1-9][0-9]*$",
          "type": "string"
        }
      },
      "required": [
        "clickRef"
      ],
      "title": "ClickRef",
      "type": "object"
    },
    "ClickRibbon": {
      "additionalProperties": false,
      "description": "Щелчок по кнопке ленты. Главная: «Σ Автосумма», «Копировать», «Вставить», «Найти и выделить ▾ → Заменить…».\nФормулы → Определённые имена: «Диспетчер имён», «Присвоить имя», «Создать из выделенного», «Применить имена…»\n(из меню «Присвоить имя»). Данные → Работа с данными: «Текст по столбцам», «Мгновенное заполнение».",
      "properties": {
        "clickRibbon": {
          "enum": [
            "autosum",
            "copy",
            "paste",
            "nameManager",
            "defineName",
            "createFromSelection",
            "applyNames",
            "findReplace",
            "textToColumns",
            "flashFill"
          ],
          "type": "string"
        }
      },
      "required": [
        "clickRibbon"
      ],
      "title": "ClickRibbon",
      "type": "object"
    },
    "ContextMenu": {
      "additionalProperties": false,
      "description": "Щелчок правой кнопкой по выделению → пункт контекстного меню («Формат ячеек…»).",
      "properties": {
        "contextMenu": {
          "const": "formatCells",
          "type": "string"
        }
      },
      "required": [
        "contextMenu"
      ],
      "title": "ContextMenu",
      "type": "object"
    },
    "DialogButton": {
      "additionalProperties": false,
      "description": "Кнопка окна: «OK», «Отмена», «Закрыть», «Создать…», «Изменить…», «Удалить», «Все имена».",
      "properties": {
        "dialogButton": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "dialogButton"
      ],
      "title": "DialogButton",
      "type": "object"
    },
    "DialogCheck": {
      "additionalProperties": false,
      "description": "Флажок в окне («в столбце слева»): щелчок меняет его состояние.",
      "properties": {
        "dialogCheck": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "dialogCheck"
      ],
      "title": "DialogCheck",
      "type": "object"
    },
    "DialogChoose": {
      "additionalProperties": false,
      "description": "Раскрывающийся список в окне («Область» → «Лист1»).",
      "properties": {
        "dialogChoose": {
          "$ref": "#/$defs/DialogChooseSpec"
        }
      },
      "required": [
        "dialogChoose"
      ],
      "title": "DialogChoose",
      "type": "object"
    },
    "DialogChooseSpec": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "minLength": 1,
          "type": "string"
        },
        "option": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "field",
        "option"
      ],
      "title": "DialogChooseSpec",
      "type": "object"
    },
    "DialogPick": {
      "additionalProperties": false,
      "description": "Щелчок по строке списка в окне (имя в диспетчере, в «Вставке имени», в «Применении имён»).",
      "properties": {
        "dialogPick": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/DialogPickSpec"
            }
          ]
        }
      },
      "required": [
        "dialogPick"
      ],
      "title": "DialogPick",
      "type": "object"
    },
    "DialogPickSpec": {
      "additionalProperties": false,
      "properties": {
        "item": {
          "minLength": 1,
          "type": "string"
        },
        "add": {
          "anyOf": [
            {
              "enum": [
                "ctrl",
                "shift"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Добавить к выбору с Ctrl или Shift"
        }
      },
      "required": [
        "item"
      ],
      "title": "DialogPickSpec",
      "type": "object"
    },
    "DialogRange": {
      "additionalProperties": false,
      "description": "Выделить диапазон мышью на листе, пока в окне активно поле ссылки (=Лист1!$A$2:$B$7).",
      "properties": {
        "dialogRange": {
          "$ref": "#/$defs/DialogRangeSpec"
        }
      },
      "required": [
        "dialogRange"
      ],
      "title": "DialogRange",
      "type": "object"
    },
    "DialogRangeSpec": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "minLength": 1,
          "type": "string"
        },
        "range": {
          "pattern": "^[A-Z]{1,3}[1-9][0-9]*(:[A-Z]{1,3}[1-9][0-9]*)?$",
          "type": "string"
        }
      },
      "required": [
        "field",
        "range"
      ],
      "title": "DialogRangeSpec",
      "type": "object"
    },
    "DialogType": {
      "additionalProperties": false,
      "description": "Набор текста в поле открытого окна (поле очищается).",
      "properties": {
        "dialogType": {
          "$ref": "#/$defs/DialogTypeSpec"
        }
      },
      "required": [
        "dialogType"
      ],
      "title": "DialogType",
      "type": "object"
    },
    "DialogTypeSpec": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "description": "Подпись поля окна: «Имя», «Диапазон», «Примечание»",
          "minLength": 1,
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "field",
        "text"
      ],
      "title": "DialogTypeSpec",
      "type": "object"
    },
    "DragRef": {
      "additionalProperties": false,
      "properties": {
        "dragRef": {
          "pattern": "^[A-Z]{1,3}[1-9][0-9]*(:[A-Z]{1,3}[1-9][0-9]*)?$",
          "type": "string"
        }
      },
      "required": [
        "dragRef"
      ],
      "title": "DragRef",
      "type": "object"
    },
    "DragSelect": {
      "additionalProperties": false,
      "properties": {
        "dragSelect": {
          "pattern": "^[A-Z]{1,3}[1-9][0-9]*(:[A-Z]{1,3}[1-9][0-9]*)?$",
          "type": "string"
        }
      },
      "required": [
        "dragSelect"
      ],
      "title": "DragSelect",
      "type": "object"
    },
    "Fill": {
      "additionalProperties": false,
      "properties": {
        "fill": {
          "pattern": "^[A-Z]{1,3}[1-9][0-9]*(:[A-Z]{1,3}[1-9][0-9]*)?$",
          "type": "string"
        }
      },
      "required": [
        "fill"
      ],
      "title": "Fill",
      "type": "object"
    },
    "HideColumns": {
      "additionalProperties": false,
      "description": "Протянуть по заголовкам столбцов и скрыть их: Главная → Формат → Скрыть или отобразить → Скрыть столбцы.",
      "properties": {
        "hideColumns": {
          "pattern": "^[A-Z]{1,3}(:[A-Z]{1,3})?$",
          "type": "string"
        }
      },
      "required": [
        "hideColumns"
      ],
      "title": "HideColumns",
      "type": "object"
    },
    "Keys": {
      "additionalProperties": false,
      "properties": {
        "keys": {
          "items": {
            "enum": [
              "Enter",
              "Escape",
              "Tab",
              "Delete",
              "F2",
              "F3",
              "F4",
              "Ctrl",
              "Alt",
              "Shift",
              "C",
              "V",
              "X",
              "Z",
              "E",
              "1",
              "=",
              ";"
            ],
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "keys"
      ],
      "title": "Keys",
      "type": "object"
    },
    "NameBox": {
      "additionalProperties": false,
      "description": "Щелчок в поле «Имя», набор имени и Enter: имя выделенному диапазону (или переход к существующему).",
      "properties": {
        "nameBox": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "nameBox"
      ],
      "title": "NameBox",
      "type": "object"
    },
    "NameList": {
      "additionalProperties": false,
      "description": "Стрелка поля «Имя» → список имён → щелчок по имени: Excel выделяет его диапазон.",
      "properties": {
        "nameList": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "nameList"
      ],
      "title": "NameList",
      "type": "object"
    },
    "NameSpec": {
      "additionalProperties": false,
      "description": "Имя, уже определённое в книге к началу урока.",
      "properties": {
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "ref": {
          "description": "Диапазон: B6, B6:B55, 12:12, A:A, Лист2!E4:E6; несколько частей — через запятую",
          "minLength": 1,
          "type": "string"
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Лист для области «лист»; по умолчанию — книга"
        },
        "comment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "relativeTo": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{1,3}[1-9][0-9]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ячейка, от которой отсчитана относительная ссылка (B7 для «предыдущий_год» = B6)"
        }
      },
      "required": [
        "name",
        "ref"
      ],
      "title": "NameSpec",
      "type": "object"
    },
    "RibbonTab": {
      "additionalProperties": false,
      "description": "Переключить вкладку ленты.",
      "properties": {
        "ribbonTab": {
          "enum": [
            "home",
            "formulas",
            "data"
          ],
          "type": "string"
        }
      },
      "required": [
        "ribbonTab"
      ],
      "title": "RibbonTab",
      "type": "object"
    },
    "Select": {
      "additionalProperties": false,
      "properties": {
        "select": {
          "pattern": "^[A-Z]{1,3}[1-9][0-9]*(:[A-Z]{1,3}[1-9][0-9]*)?$",
          "type": "string"
        }
      },
      "required": [
        "select"
      ],
      "title": "Select",
      "type": "object"
    },
    "SelectAll": {
      "additionalProperties": false,
      "description": "Кнопка «Выделить всё» на пересечении заголовков.",
      "properties": {
        "selectAll": {
          "const": true,
          "type": "boolean"
        }
      },
      "required": [
        "selectAll"
      ],
      "title": "SelectAll",
      "type": "object"
    },
    "SelectColumn": {
      "additionalProperties": false,
      "description": "Щелчок по букве столбца — выделение всего столбца.",
      "properties": {
        "selectColumn": {
          "pattern": "^[A-Z]{1,3}$",
          "type": "string"
        }
      },
      "required": [
        "selectColumn"
      ],
      "title": "SelectColumn",
      "type": "object"
    },
    "SelectRow": {
      "additionalProperties": false,
      "description": "Щелчок по номеру строки — выделение всей строки.",
      "properties": {
        "selectRow": {
          "maximum": 1048576,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "selectRow"
      ],
      "title": "SelectRow",
      "type": "object"
    },
    "Sheet": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Имя файла в окне Excel, например Wagestemp.xlsx"
        },
        "name": {
          "default": "Лист1",
          "type": "string"
        },
        "columns": {
          "description": "Ширина колонок в пикселях",
          "patternProperties": {
            "^[A-Z]{1,3}$": {
              "type": "integer"
            }
          },
          "type": "object"
        },
        "rows": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Сколько строк показывать"
        },
        "cells": {
          "patternProperties": {
            "^[A-Z]{1,3}[1-9][0-9]*$": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/CellSpec"
                }
              ]
            }
          },
          "type": "object"
        }
      },
      "title": "Sheet",
      "type": "object"
    },
    "SheetTab": {
      "additionalProperties": false,
      "description": "Щелчок по ярлыку листа.",
      "properties": {
        "sheetTab": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "sheetTab"
      ],
      "title": "SheetTab",
      "type": "object"
    },
    "ShowRefs": {
      "additionalProperties": false,
      "properties": {
        "showRefs": {
          "pattern": "^[A-Z]{1,3}[1-9][0-9]*$",
          "type": "string"
        }
      },
      "required": [
        "showRefs"
      ],
      "title": "ShowRefs",
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "description": "Заголовок шага; плейсхолдеры как в text",
          "minLength": 1,
          "type": "string"
        },
        "text": {
          "description": "Пояснение на экране; разрешены <b>, <code>, <kbd>, плейсхолдеры {fn:SUM} и {f:=SUM(A1:A3)}",
          "minLength": 1,
          "type": "string"
        },
        "actions": {
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/Click"
              },
              {
                "$ref": "#/$defs/Select"
              },
              {
                "$ref": "#/$defs/Type"
              },
              {
                "$ref": "#/$defs/ClickRef"
              },
              {
                "$ref": "#/$defs/DragRef"
              },
              {
                "$ref": "#/$defs/DragSelect"
              },
              {
                "$ref": "#/$defs/Fill"
              },
              {
                "$ref": "#/$defs/Keys"
              },
              {
                "$ref": "#/$defs/ShowRefs"
              },
              {
                "$ref": "#/$defs/Wait"
              },
              {
                "$ref": "#/$defs/ClickRibbon"
              },
              {
                "$ref": "#/$defs/RibbonTab"
              },
              {
                "$ref": "#/$defs/NameBox"
              },
              {
                "$ref": "#/$defs/NameList"
              },
              {
                "$ref": "#/$defs/SheetTab"
              },
              {
                "$ref": "#/$defs/AddSelect"
              },
              {
                "$ref": "#/$defs/SelectRow"
              },
              {
                "$ref": "#/$defs/SelectColumn"
              },
              {
                "$ref": "#/$defs/SelectAll"
              },
              {
                "$ref": "#/$defs/HideColumns"
              },
              {
                "$ref": "#/$defs/Autocomplete"
              },
              {
                "$ref": "#/$defs/ContextMenu"
              },
              {
                "$ref": "#/$defs/DialogType"
              },
              {
                "$ref": "#/$defs/DialogRange"
              },
              {
                "$ref": "#/$defs/DialogCheck"
              },
              {
                "$ref": "#/$defs/DialogChoose"
              },
              {
                "$ref": "#/$defs/DialogPick"
              },
              {
                "$ref": "#/$defs/DialogButton"
              }
            ]
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "title",
        "text",
        "actions"
      ],
      "title": "Step",
      "type": "object"
    },
    "Type": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "Type",
      "type": "object"
    },
    "Wait": {
      "additionalProperties": false,
      "properties": {
        "wait": {
          "description": "Пауза в миллисекундах",
          "maximum": 10000,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "wait"
      ],
      "title": "Wait",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "Стабильный id: хранится в БД прогресса, не переименовывать",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
    },
    "chapter": {
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
    },
    "order": {
      "description": "Порядок внутри главы; 0 — вводный урок главы",
      "minimum": 0,
      "type": "integer"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Откуда сценарий, например «Рис. 1.1»"
    },
    "sheet": {
      "$ref": "#/$defs/Sheet"
    },
    "sheets": {
      "description": "Другие листы книги (ярлыки справа от первого)",
      "items": {
        "$ref": "#/$defs/Sheet"
      },
      "type": "array"
    },
    "names": {
      "description": "Имена, определённые к началу урока",
      "items": {
        "$ref": "#/$defs/NameSpec"
      },
      "type": "array"
    },
    "today": {
      "anyOf": [
        {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "«Сегодня» урока для СЕГОДНЯ() и Ctrl+; («2026-10-12»): анимация, перемотка и ответы совпадают"
    },
    "expect": {
      "description": "Значения из исходника для сверки",
      "patternProperties": {
        "^(?:[^!]+!)?[A-Z]{1,3}[1-9][0-9]*$": {
          "anyOf": [
            {
              "type": "string"
            },

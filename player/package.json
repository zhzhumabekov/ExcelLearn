{
  "name": "excellearn-player",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "gen:types": "node scripts/gen-types.mjs",
    "lessons:verify": "esbuild scripts/verify.ts --bundle --platform=node --format=esm --packages=external --outfile=.cache/verify.mjs --log-level=warning && node .cache/verify.mjs",
    "exercises:verify": "esbuild scripts/verify-exercises.ts --bundle --platform=node --format=esm --packages=external --outfile=.cache/verify-exercises.mjs --log-level=warning && node .cache/verify-exercises.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@formulajs/formulajs": "4.6.1",
    "fast-formula-parser": "1.0.19"
  }
}

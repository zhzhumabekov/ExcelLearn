# Скопируйте в .env и заполните. .env не коммитится.
DJANGO_SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Пусто = SQLite (db.sqlite3). Прод: postgres://excellearn:***@db:5432/excellearn
DATABASE_URL=

# Почта — пусто = письма в консоль, сброс пароля через администратора
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=ExcelLearn <no-reply@excellearn.kz>
# Контакт администратора на странице «Восстановление пароля», пока почта не настроена
SUPPORT_EMAIL=

# Озвучка: silent (тишина, для разработки) | windows (голос Windows, предпросмотр) | yandex
TTS_PROVIDER=silent
TTS_API_KEY=
TTS_FOLDER_ID=
TTS_VOICE=alena

# Caddy: HTTPS (сертификат Let's Encrypt выпускается и продлевается сам), сжатие; все запросы — в Django.
# SITE_DOMAIN=localhost — локальная проверка с сертификатом Caddy.
{$SITE_DOMAIN:localhost} {
	encode zstd gzip

	handle {
		reverse_proxy web:8000 {
			# Реальный IP ученика — для защиты входа от подбора пароля (apps/accounts/throttle.py)
			header_up X-Real-IP {remote_host}
		}
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

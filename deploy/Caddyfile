# Caddy: HTTPS, сжатие; все запросы — в Django.
# Сайт во внутренней сети: Let's Encrypt недоступен, сертификат задаёт CADDY_TLS (.env.production):
#   internal (по умолчанию) — свой центр сертификации Caddy; его корневой сертификат ставится на компьютеры
#   /certs/site.crt /certs/site.key — сертификат корпоративного ЦС (файлы в deploy/certs/)
# SITE_DOMAIN=localhost — локальная проверка.
{$SITE_DOMAIN:localhost} {
	tls {$CADDY_TLS:internal}
	encode zstd gzip

	handle {
		reverse_proxy web:8000 {
			# Реальный IP ученика — для защиты входа от подбора пароля (apps/accounts/throttle.py)
			header_up X-Real-IP {remote_host}
		}
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

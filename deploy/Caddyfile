# Caddy: HTTPS (сертификат Let's Encrypt выпускается и продлевается сам), сжатие, озвучка из тома media,
# всё остальное — в Django. SITE_DOMAIN=localhost — локальная проверка с сертификатом Caddy.
{$SITE_DOMAIN:localhost} {
	encode zstd gzip

	# Озвучка уроков (narration_build) — прямо с диска, без Django
	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=604800"
		file_server
	}

	handle {
		reverse_proxy web:8000 {
			# Реальный IP ученика — для защиты входа от подбора пароля (apps/accounts/throttle.py)
			header_up X-Real-IP {remote_host}
		}
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

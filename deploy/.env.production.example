# Скопируйте в .env.production в корне проекта (на VPS) и заполните. Файл не коммитится.

# Домен сайта: на него Caddy выпустит сертификат Let's Encrypt (DNS должен указывать на VPS)
SITE_DOMAIN=excellearn.kz

# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# Почта — пусто = сброс пароля через администратора
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=ExcelLearn <no-reply@excellearn.kz>
SUPPORT_EMAIL=

# Озвучка выключена, пока не решим, нужна ли она; true — собирать при старте и включить в плеере
NARRATION_ENABLED=false
# Озвучка: yandex (нужен ключ) | silent
TTS_PROVIDER=yandex
TTS_API_KEY=
TTS_FOLDER_ID=
TTS_VOICE=alena

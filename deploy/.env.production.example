# Скопируйте в .env.production в корне проекта (на сервере) и заполните. Файл не коммитится.

# Внутреннее DNS-имя сайта (запись A во внутреннем DNS → IP сервера)
SITE_DOMAIN=excellearn.company.kz

# Сертификат HTTPS (docs/deploy.md, шаги 7 и 9):
#   internal — свой ЦС Caddy, корневой сертификат раздать на компьютеры (GPO)
#   /certs/site.crt /certs/site.key — сертификат корпоративного ЦС, файлы в deploy/certs/
CADDY_TLS=internal

# HSTS: пока корневой сертификат не установлен на все компьютеры — 0 (иначе браузер не даст открыть сайт
# с недоверенным сертификатом даже через «Всё равно перейти»). После раздачи — удалить строку (по умолчанию год).
SECURE_HSTS_SECONDS=0

# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# Почта — пусто = сброс пароля через администратора
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=ExcelLearn <no-reply@excellearn.kz>
SUPPORT_EMAIL=

